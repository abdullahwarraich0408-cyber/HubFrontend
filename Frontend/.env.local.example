# Production backend (use direct URL to avoid Node.js SSL errors when proxying in dev)
NEXT_PUBLIC_API_URL=https://backend.medzoos.com/api

# Only needed when NEXT_PUBLIC_API_URL=/api (Next.js rewrite proxy)
BACKEND_URL=https://backend.medzoos.com

# Socket.io server URL (browser connects directly; not proxied through /api)
# Optional when NEXT_PUBLIC_API_URL is a full URL — derived automatically
# NEXT_PUBLIC_SOCKET_URL=https://backend.medzoos.com
# For local dev with NEXT_PUBLIC_API_URL=/api:
NEXT_PUBLIC_BACKEND_URL=https://backend.medzoos.com

# Separate panel URLs (customer site links out to these in production)
NEXT_PUBLIC_DOCTOR_PANEL_URL=https://doctor.medzoos.com

# Stripe publishable key (sandbox)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key